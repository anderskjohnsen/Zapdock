{
  "name": "zapdock",
  "productName": "Zapdock",
  "version": "1.0.0",
  "description": "Oppgavelinje-erstatning for Windows med moduler: Claude Code-økter, Spotify, YouTube, Stremio, live WoW-forhåndsvisning, kalender, vær, timer, notater, utklipp og systemmonitor.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-syntax.js && node scripts/test-claude-usage.js && node scripts/test-ics.js",
    "dist": "electron-builder --win nsis portable",
    "test": "npm run check"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "xyz.zapdock.app",
    "productName": "Zapdock",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Zapdock",
      "runAfterFinish": true
    },
    "asarUnpack": [
      "node_modules/koffi/**",
      "src/main/helpers/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "portable": {
      "artifactName": "Zapdock-${version}-portable.exe"
    }
  }
}
